# --- Supabase (free tier: supabase.com) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (free to integrate; pay-as-you-go fees only) -------------------
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the Dashboard's webhook endpoint once deployed
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID for the $7/month Pro plan (Stripe Dashboard > Product catalog)
STRIPE_PRICE_ID_PRO=price_xxx

# --- Lemon Squeezy (optional alternative/supplement to Stripe) -------------
LEMONSQUEEZY_API_KEY=xxx
LEMONSQUEEZY_WEBHOOK_SECRET=xxx
LEMONSQUEEZY_STORE_ID=xxx
LEMONSQUEEZY_VARIANT_ID_PRO=xxx

# --- Email (optional — app runs fine without this, see lib/email.ts) ------
EMAIL_PROVIDER_API_KEY=
